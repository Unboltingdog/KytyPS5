# Writes kytyShaderCacheVersion.h: a hash of every source that decides what the shader store
# (_PipelineCache/<title>.shaders) holds and how it is read. The store is reused across emulator
# builds while this hash stays the same, and started over when it changes.
#
# Inputs: SOURCE_DIR (the repository root), OUTPUT_FILE.
if(NOT SOURCE_DIR OR NOT OUTPUT_FILE)
	message(FATAL_ERROR "generate_shader_cache_version.cmake requires SOURCE_DIR and OUTPUT_FILE")
endif()

# Bump by hand to discard every store even when no hashed source changed.
set(FORMAT_VERSION 1)

file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${SOURCE_DIR}"
	# The recompiler: the SPIR-V and the module info the store keeps.
	"${SOURCE_DIR}/src/graphics/shader/*"
	# Program keys, record layout and pipeline creation. A stored pipeline key fully describes its
	# pipeline, so draw code that builds keys differently only misses; it is not hashed.
	"${SOURCE_DIR}/src/graphics/host_gpu/renderer/pipeline/*"
)
file(GLOB more LIST_DIRECTORIES false RELATIVE "${SOURCE_DIR}"
	# The types the keys are made of (render targets, render state), not the subfolders.
	"${SOURCE_DIR}/src/graphics/host_gpu/renderer/*.h"
	# The SPIR-V definitions the emitter writes against.
	"${SOURCE_DIR}/3rdparty/SPIRV-Headers/include/spirv/unified1/spirv.hpp"
	"${SOURCE_DIR}/3rdparty/SPIRV-Headers/include/spirv/unified1/GLSL.std.450.h"
	# This script.
	"${SOURCE_DIR}/src/generate_shader_cache_version.cmake"
)
list(APPEND files ${more})
list(SORT files)

set(manifest "format ${FORMAT_VERSION}\n")
foreach(file IN LISTS files)
	# Line endings differ between checkouts of the same commit; hash the text without them.
	file(READ "${SOURCE_DIR}/${file}" content)
	string(REPLACE "\r\n" "\n" content "${content}")
	string(SHA256 digest "${content}")
	string(APPEND manifest "${file} ${digest}\n")
endforeach()
string(SHA256 total "${manifest}")
string(SUBSTRING "${total}" 0 16 hash)
list(LENGTH files count)

set(text "// Generated by generate_shader_cache_version.cmake from ${count} files; do not edit.
#pragma once
#define KYTY_SHADER_CACHE_VERSION 0x${hash}ULL
")
# Rewritten only when the hash changes, so unchanged sources do not rebuild what includes it.
if(EXISTS "${OUTPUT_FILE}")
	file(READ "${OUTPUT_FILE}" old)
	if(old STREQUAL text)
		return()
	endif()
endif()
file(WRITE "${OUTPUT_FILE}" "${text}")
message(STATUS "Shader cache version: ${hash} (${count} files)")
